<?xml version="1.0"?>
<package format="3">
  <name>waypoint_navigation</name>
  <version>0.0.0</version>
  <description>Custom interfaces (msg, srv, action) for waypoint navigation</description>

  <maintainer email="divit@example.com">Divit Khandelwal</maintainer>
  <license>Apache-2.0</license>

  <!-- Dependencies for building interface definitions -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Declare this package as providing ROS interfaces -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

